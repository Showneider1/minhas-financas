# ============================================================
# Finance OS — Exemplo de variáveis de ambiente
# COPIE para .env e preencha. NUNCA commite o .env real.
# Este arquivo contém apenas NOMES, nenhum valor secreto.
# ============================================================

# ---------- Aplicação ----------
APP_NAME=Sistema Financeiro Pessoal
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=False
HOST=0.0.0.0
PORT=8050

# Domínio público usado pelo Caddy (HTTPS automático)
DOMAIN=localhost

# ---------- Banco de dados ----------
# Local SQLite (padrão dev/test):
DATABASE_URL=sqlite:///./data/finance.db
# Postgres local (docker-compose):
# DATABASE_URL=postgresql://user:password@localhost:5432/finance_os
# Supabase Pooler (staging/prod — porta 6543 + sslmode=require):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# ---------- Postgres local (docker-compose staging) ----------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=finance_os

# ---------- Segurança / JWT ----------
SECRET_KEY=troque-por-valor-longo-aleatorio
JWT_SECRET_KEY=troque-por-outro-valor-longo-aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Supabase (staging futuro — PREENCHIMENTO OFFLINE PELO OPERADOR) ----------
# Copie este bloco para o .env e substitua PREENCHER_OFFLINE pelas chaves reais.
# NUNCA commite o .env. Service role: SOMENTE servidor/vault, NUNCA no frontend.
SUPABASE_URL="PREENCHER_OFFLINE"
SUPABASE_ANON_KEY="PREENCHER_OFFLINE"
SUPABASE_SERVICE_ROLE_KEY="PREENCHER_OFFLINE"
SUPABASE_DB_URL_POOLER="postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB]"

# ---------- Logs / Features ----------
LOG_LEVEL=INFO
LOG_FORMAT=detailed
LOG_FILE=logs/app.log
AUDIT_LOG_FILE=logs/audit.log
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=300
ENABLE_REGISTRATION=True
ENABLE_EMAIL_VERIFICATION=False
ENABLE_PASSWORD_RESET=True
AUDIT_ENABLED=True
